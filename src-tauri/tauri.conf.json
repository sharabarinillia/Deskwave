{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deskwave",
  "version": "0.3.0",
  "identifier": "app.deskwave.desktop",
  "build": {
    "frontendDist": "../ui",
    "beforeBundleCommand": "node scripts/installer-license.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data: asset: http://asset.localhost",
        "media-src": "'self' asset: http://asset.localhost",
        "font-src": "'self'",
        "frame-src": "http://dwmod.localhost dwmod:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "Utility",
    "shortDescription": "Animated wallpapers and desktop widgets",
    "copyright": "© 2026 sharabarinillia. Free for non-commercial use only.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../mods/": "mods/",
      "../sdk/": "sdk/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer/hooks.nsh"
      }
    },
    "publisher": "sharabarinillia",
    "homepage": "https://github.com/sharabarinillia/Deskwave",
    "licenseFile": "installer/license.txt",
    "longDescription": "Animated wallpapers and desktop widgets for Windows. Offline by default."
  }
}
