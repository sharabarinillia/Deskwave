{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "wallpaper",
  "description": "Wallpaper layer: read its wallpaper, listen for events, and fetch for an approved wallpaper mod.",
  "windows": [
    "wallpaper-*"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-wallpaper-get",
    "allow-net-fetch"
  ]
}
